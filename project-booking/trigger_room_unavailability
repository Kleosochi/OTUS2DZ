CREATE TABLE room_unavailability (
  unavailability_id SERIAL PRIMARY KEY,
  room_id INT NOT NULL REFERENCES rooms(id),
  date_from DATE NOT NULL,
  date_to   DATE NOT NULL,
  reason    VARCHAR(255) NOT NULL,  -- 'maintenance', 'cleaning_deep', 'renovation' и т.д.
  CONSTRAINT chk_dates CHECK (date_from <= date_to)
);

CREATE INDEX idx_room_unavailability_room_dates
  ON room_unavailability(room_id, date_from, date_to);

