 1. Создаём категорию

INSERT INTO room_categories (category_code, description, base_price_per_night)
SELECT 'STANDARD', 'Стандартный номер', 5000.00
WHERE NOT EXISTS (
    SELECT 1 FROM room_categories WHERE category_code = 'STANDARD'
);

 2. Создаём номер

WITH cat AS (
    SELECT id FROM room_categories WHERE category_code = 'STANDARD' LIMIT 1
)
INSERT INTO rooms (room_number, category_id, max_occupancy, allow_pets, is_active)
SELECT '101', c.id, 2, FALSE, TRUE
FROM cat c
WHERE NOT EXISTS (
    SELECT 1 FROM rooms WHERE room_number = '101'
);

 3. Получаем реальный room_id

DO $$
DECLARE
    v_room_id INT;
    v_first_booking_id INT;
BEGIN
    SELECT id INTO v_room_id FROM rooms WHERE room_number = '101';
    RAISE NOTICE 'Используем room_id = % для теста', v_room_id;
    SELECT fn_create_booking(v_room_id, '2025-10-01', '2025-10-05', 20000)
    INTO v_first_booking_id;
    RAISE NOTICE 'Первая бронь создана: id = %', v_first_booking_id;
    SELECT fn_create_booking(v_room_id, '2025-10-03', '2025-10-07', 20000);
END $$;
