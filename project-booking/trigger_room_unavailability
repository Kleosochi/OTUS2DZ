CREATE OR REPLACE VIEW v_room_occupancy_new AS
SELECT
  r.id,
  r.room_number,
  r.category_id,
  d.date_ref,
  EXISTS (
    SELECT 1
    FROM bookings b
    WHERE b.room_id = r.id
      AND b.booking_status IN ('confirmed', 'checked_in')
      AND d.date_ref BETWEEN b.checkin_date AND b.checkout_date
  ) AS is_booked_on_date,
  EXISTS (
    SELECT 1
    FROM room_unavailability u
    WHERE u.room_id = r.id
      AND d.date_ref BETWEEN u.date_from AND u.date_to
  ) AS is_blocked_on_date,
  CASE
    WHEN EXISTS (
      SELECT 1
      FROM bookings b
      WHERE b.room_id = r.id
        AND b.booking_status IN ('confirmed', 'checked_in')
        AND d.date_ref BETWEEN b.checkin_date AND b.checkout_date
    ) THEN 'booked'
    WHEN EXISTS (
      SELECT 1
      FROM room_unavailability u
      WHERE u.room_id = r.id
        AND d.date_ref BETWEEN u.date_from AND u.date_to
    ) THEN 'blocked'
    ELSE 'available'
  END AS occupancy_status_on_date,
  r.current_state AS current_room_state
FROM rooms r
CROSS JOIN generate_series(
  (SELECT LEAST(MIN(checkin_date), CURRENT_DATE) FROM bookings),
  (SELECT GREATEST(MAX(checkout_date), CURRENT_DATE + INTERVAL '90 days') FROM bookings),
  INTERVAL '1 day'
) AS d(date_ref);

